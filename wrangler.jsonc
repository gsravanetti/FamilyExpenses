{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "family-expenses",
  "main": "./worker-entry.js",
  "compatibility_date": "2026-09-15",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "vars": {
    "GOOGLE_CLIENT_ID": "177628124658-c9km173ch1v1ph1akoqvmapjgpo1pt0s.apps.googleusercontent.com"
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
